{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Custom Keyword Highlighter",
  "version": "1.4.0",
  "description": "Highlight คำ/ตัวอักษรที่กำหนดเองในทุกเว็บไซต์ เช่น xxx,yyy,zzz + Sync Anki via Anki-Connect",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keyword Highlighter"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["anki.js", "highlight.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
